    in-out property <string> image-filter-label: "";
    in-out property <[ImageFilterParam]> image-filter-params: [];
    in-out property <image> image-filter-preview;
    in-out property <string> image-filter-warning: "";
    in-out property <bool> image-filter-liquify: false;
    // The Filter menu's rows (headers + filters), built once by Rust.
    in-out property <[FilterMenuRow]> filter-menu-rows: [];
    in-out property <bool> image-modal-open: false;
    in-out property <string> image-modal-mode: "image-size";
    in-out property <string> image-modal-a: "";
    in-out property <string> image-modal-b: "";
    in-out property <bool> image-modal-constrain: true;
