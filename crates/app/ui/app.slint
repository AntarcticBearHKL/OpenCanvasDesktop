    in-out property <[ImageActionRow]> image-actions: [];
    in-out property <bool> image-recording: false;
    in-out property <int> image-recorded: 0;
    in-out property <[ImageAssetRow]> image-assets: [];
    in-out property <string> image-asset-search: "";
    in-out property <[ImageAdjustmentGroup]> image-adjustments: [];
    in-out property <[ImageGradientRow]> image-gradients: [];
    in-out property <[ImageGradientStopRow]> image-gradient-stops: [];
    in-out property <[ImageGradientStopRow]> image-editor-stops: [];
    in-out property <image> image-gradient-edit-strip;
    in-out property <string> image-gradient-name: "";
    in-out property <int> image-gradient-stop-selected: 0;
    in-out property <[ImagePatternRow]> image-patterns: [];
    in-out property <bool> image-pattern-can-define: false;
    in-out property <[ImageBrushRow]> image-brushes: [];
    in-out property <image> image-brush-preview;
    in-out property <float> image-brush-spacing: 15;
    in-out property <float> image-brush-scatter: 0;
    in-out property <float> image-brush-angle: 0;
    in-out property <float> image-brush-roundness: 100;
