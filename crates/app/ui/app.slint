    in-out property <string> image-modal-skew-x: "0";
    in-out property <string> image-modal-skew-y: "0";
    in-out property <string> image-modal-message: "";
    // Canvas-area size polled by Rust (the hidden workspace has no size event).
    out property <length> image-canvas-width: image-ws.canvas-w;
    out property <length> image-canvas-height: image-ws.canvas-h;

    // The creatable built-in types, as the dock's node buttons expose them.
    out property <[string]> create-types: dock.create-types;

    callback canvas-pointer(string, length, length, string, bool, bool);
    callback canvas-scroll(length, length, float);
    callback canvas-resized(length, length);
    callback node-pointer(string, string, length, length, string, bool);
    callback resize-pointer(string, string, string, length, length);
