// Baloo 2 (wght 400-800, variable TTF) - embedded and registered at startup by
// this import; see src/main.rs for why this is the Slint 1.18 registration API.
import "../assets/fonts/Baloo2-Variable.ttf";

// A canvas node row. World coordinates are pre-scale; the canvas layers map them
// with a shared viewbox bound to `scale` / `vp-x` / `vp-y`, so pan and zoom only
// touch three scalar properties (no model rebuild, no tween - motion-catalog ??).
export struct NodeItem {
    id: string,
    kind: string,
    title: string,
    body: string,
    body-size: length,
    // Explicit text colour (`metadata.text_color`) plus its enable flag, so an
    // unset colour falls back to the theme ink per theme.
    body-color: color,
    body-colored: bool,
    media: bool,
    world-x: length,
    world-y: length,
    width: length,
    height: length,
    selected: bool,
    locked: bool,
    enter: float,
    // Plugin node content resolved by the host bridge (empty for built-ins).
    plugin-kind: string,
    plugin-text: string,
    plugin-raw: string,
    plugin-empty: bool,
    plugin-editing: bool,
    plugin-interactive: bool,
    plugin-transparent: bool,
    plugin-bg: color,
    plugin-image: image,
    plugin-palette-open: bool,
    plugin-palette: [color],
    has-source: bool,
    has-target: bool,
    // Media/content layer (`vm::node_row`): the decoded body bitmap (image
    // content, video poster, stack cover), its fit and the empty flag.
    content-image: image,
    content-fit: string,
    content-empty: bool,
    // Status surface: "" | "loading" | "error" + the error detail line.
    status: string,
    error-text: string,
    status-label: string,
    // Media info bar (`MediaInfoBar`); `media-info` picks it over the title.
    info: string,
    media-info: bool,
    // Image-stack contact sheet: decoded cover + backing rows (precomputed heap
    // offsets) + the count chip.
    stack-cover: image,
    stack: [StackImage],
    stack-count: int,
    stack-count-label: string,
    stack-cover-error: string,
    // Assets list + footer.
    assets: [AssetItem],
    asset-count: int,
    asset-count-label: string,
    asset-source: string,
    // Bound local folder (assets node): the rooted tree, the binding state, the
    // folder path shown in the header and the error/status line.
    asset-tree: [AssetTreeRow],
    asset-bound: bool,
    asset-folder: string,
    asset-error: string,
    // Video duration label (`"0:06"`).
    duration: string,
    // Batch text alternatives (`metadata.texts`).
    batch-count: int,
    batch-label: string,
    batch: [TextOptionRow],
    // Related/focus highlight (project.tsx relatedHighlight) and the body/title
    // in-place editor state. There is deliberately no dim flag: selection never
    // fades unrelated nodes.
    related: bool,
    editing: bool,
    edit-text: string,
    editing-title: bool,
    title-draft: string,
    // Video-prompt slots (`metadata.videoSlots`) and the active drop zone. The
    // reference count is the card's editable N; `slot-refs` is replaced by
    // `ref-slot-titles`, one title per reference slot.
    slot-first: string,
    slot-last: string,
    ref-slot-count: int,
    ref-slot-titles: [string],
    slot-drop: string,
    // Video-prompt generation mode (`metadata.videoMode`): "frames" | "reference".
    video-mode: string,
    // Prompt editor session of this row (double-click opens it).
    prompt-caret: int,
    prompt-caret-seq: int,
    // True while this prompt body is in edit mode (double-click opened it).
    prompt-editing: bool,
    // Thumbnails of the image nodes connected into this prompt node.
    ref-images: [RefImage],
    // Generation card body: model, parameters and action state.
    mode: string,
    model: string,
    // Provider brand letter of the selected model (the model row's badge).
    model-brand: string,
    settings-label: string,
    generation-settings: GenerationSettings,
    open-popover: string,
    can-generate: bool,
    running: bool,
    attempt-version: int,
    attempt-title: string,
    attempt-reason: string,
    attempt-frozen: bool,
    attempt-current: bool,
    attempt-run-count: int,
    attempt-image-count: int,
    attempt-trace-count: int,
}

// World-space path: `viewbox` slides over world coordinates and scales by k, so
// stroke widths stay constant in screen pixels (femtovg strokes after fitting).
component WorldPath inherits Path {
    in property <float> viewport-scale: 1;
    in property <length> viewport-x: 0px;
    in property <length> viewport-y: 0px;

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    fit: fill;
    fill: transparent;
    // The grid and the wire layer are huge paths (thousands of dot segments).
    // Without a cache, ANY overlay animation (the create menu's 160ms reveal,
    // popovers, modals) re-rasterises them every frame, which made the
    // right-click menu feel stuck. Slint invalidates the cache when the path
    // or its viewport changes, so panning still updates 1:1.
    cache-rendering-hint: true;
    viewbox-x: -(self.viewport-x / 1px) / self.viewport-scale;
    viewbox-y: -(self.viewport-y / 1px) / self.viewport-scale;
    viewbox-width: (self.width / 1px) / self.viewport-scale;
    viewbox-height: (self.height / 1px) / self.viewport-scale;
}

// Screen-space path (guides, marquee border, active connection): commands are
// already in canvas pixels, so the natural size must not be re-fitted.
component ScreenPath inherits Path {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    fit: preserve;
    fill: transparent;
}

// Shell blueprint: the home screen (folder rail + canvas table), the canvas
// (side panel + edge-to-edge canvas section; the dock floats bottom-center) and
// the Image Studio (its own menu and panels). The canvas section renders from
// the Rust-owned model and forwards every pointer event upwards; P2 adds
// pan/zoom, selection, node drag/resize, connections and shortcuts.
export component AppWindow inherits Window {
    title: "OpenCanvas";
    // Frameless: the home screen's header carries the window controls, the
    // canvas moves with a left-drag and the studio draws its own menu bar.
    // Do NOT pin
    // width/height here: a constant binding freezes Slint's surface size, so an
    // OS resize leaves the layout drawn at the old size ??the initial size is
    // pushed from Rust (`main.rs`) instead. A floor plus a resize border keep
    // the frameless window resizable at its edges.
    no-frame: true;
    min-width: 1024px;
    min-height: 640px;
    // Transparent root: the captured, blurred desktop is painted by the
    // `glass-backdrop` image below, and the plate paints the theme tint over
    // it. The winit backend still creates the window transparent so the first
    // frames (before the capture lands) show the live desktop instead of a
    // black surface.
    resize-border-width: 6px;
    background: transparent;
    // Web stack: "Baloo 2", "Resource Han Rounded SC", "Microsoft YaHei",
    // system-ui, sans-serif. Slint's font-family takes a single family name and
    // appends its generic fallbacks (SansSerif -> SystemUi) plus fontique's
    // script fallback, which resolves CJK to the OS Han font.
    default-font-family: "Baloo 2";

    // ---- custom window chrome ---------------------------------------------
    // True while the window is maximised: swaps the maximise glyph for restore.
    in-out property <bool> window-maximized: false;
    // True when the OS accepted the transparent-window request. The captured
    // blurred desktop is the primary backdrop; this flag is only the fallback
    // for the first frames before the capture lands.
    in-out property <bool> backdrop: false;
    // ---- captured frosted backdrop --------------------------------------
    // The whole-desktop capture, blurred in Rust (`glass_capture.rs`) and
    // pinned to the desktop: x/y are the capture origin minus the window
    // origin, and w/h are the capture size, all in logical pixels. The image
    // is declared before the root plate so it paints underneath the tint.
    in property <image> glass-backdrop;
    in property <bool> glass-backdrop-valid: false;
    in property <length> glass-x: 0px;
    in property <length> glass-y: 0px;
    in property <length> glass-w: 0px;
    in property <length> glass-h: 0px;
    callback win-minimize();
    callback win-maximize-toggle();
    callback win-close();
    // Manual window move (keeps the event loop running while the window moves;
    // the home header, a left-drag on the canvas and the studio's own drag
    // affordance all feed these three).
    callback drag-begin();
    callback drag-tick();
    callback drag-end();

    in-out property <[NodeItem]> nodes: [];
    in-out property <string> wires: "";
    // Dot-grid background.
    //
    // Shipped: `grid-tile` is a pre-rendered bitmap holding `grid-tile-w /
    // grid-step` dots per axis, repeated by the `grid-indices` lattice below.
    // The grid is screen-anchored: `grid-step` (the on-screen spacing) and the
    // bitmap are constants, so zooming changes nothing here. Only the lattice
    // offsets are bindings on `vp-x`/`vp-y`, so panning never rebuilds
    // anything.
    //
    // Legacy (`legacy-grid`, `OC_LEGACY_GRID=1`): `grid` is the world-space
    // command string of one dot segment per intersection, re-tessellated
    // whenever the viewport moves. Kept for the before/after benchmark.
    in-out property <string> grid: "";
    in-out property <bool> legacy-grid: false;
    in-out property <image> grid-tile;
    in-out property <float> grid-step: 26;
    in-out property <float> grid-tile-w: 416;
    in-out property <float> grid-tile-h: 416;
    in-out property <[int]> grid-indices: [0];
    in-out property <int> grid-cols: 1;
    in-out property <int> grid-rows: 1;
    // Scroll phase of the tile lattice: one tile before the canvas, so a dot
    // sits on the canvas origin at any pan offset. The pan is rounded to a
    // whole pixel before the wrap: sampling the tile at a fractional position
    // would resample the 2.5px dot (blur/shimmer while panning). `Math.mod` is
    // Euclidean (`rem_euclid`), so the phase is in [0, tile].
    out property <float> grid-phase-x: Math.round(Math.mod(root.vp-x / 1px - root.grid-step * 0.5, root.grid-tile-w));
    out property <float> grid-phase-y: Math.round(Math.mod(root.vp-y / 1px - root.grid-step * 0.5, root.grid-tile-h));
    in-out property <float> scale: 1;
    in-out property <length> vp-x: 0px;
    in-out property <length> vp-y: 0px;
    in-out property <string> active-wire: "";
    in-out property <string> guides: "";
    in-out property <bool> marquee-visible: false;
    in-out property <length> marquee-x: 0px;
    in-out property <length> marquee-y: 0px;
    in-out property <length> marquee-width: 0px;
    in-out property <length> marquee-height: 0px;
    in-out property <string> marquee-border: "";
    in-out property <string> connect-target-id: "";
    // Wire editing: selected wire path and the Ctrl+right cut stroke (both
    // paths owned by Rust).
    in-out property <string> selected-wire: "";
    in-out property <string> cut-stroke: "";
    // Selected-edge explanation: the agent-written reason/diff shown as a
    // small pill at the edge midpoint. Edge metadata is persisted even when
    // no pill is visible.
    in-out property <bool> edge-reason-visible: false;
    in-out property <string> edge-reason-text: "";
    in-out property <length> edge-reason-x: 0px;
    in-out property <length> edge-reason-y: 0px;
    // Node-drop bindings: highlighted target + slot zone, and the drag ghost.
    in-out property <string> drop-target-id: "";
    in-out property <string> drop-slot: "";
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <bool> has-selection: false;
    in-out property <bool> space-held: false;
    in-out property <bool> panning: false;
    // True while a node card is being dragged. Clipping is disabled for the
    // gesture so femtovg does not create a fresh clip layer per card on the
    // first moving frame (the visible hitch at drag start).
    in-out property <bool> drag-active: false;
    // True only for the press that the Rust canvas handler classified as empty
    // background (not a wire, not Shift+marquee). The background layer starts
    // the manual window move when it sees this; nodes never reach it.
    in-out property <bool> canvas-window-drag: false;
    // Hold-to-home ring: visible while the right button is still on the canvas.
    // `home-hold-x/y` are canvas-local pixels; the arc is a 24x24 SVG path
    // generated by Rust (`app::home_hold_arc`) from 0..1 progress.
    in-out property <bool> home-hold-visible: false;
    in-out property <float> home-hold-progress: 0;
    in-out property <length> home-hold-x: 0px;
    in-out property <length> home-hold-y: 0px;
    in-out property <string> home-hold-arc: "";

    // Zoom read-out of the canvas overlay pill (`zoom-badge-visible` is the
    // fade target Rust drives; the label is the formatted percentage).
    in-out property <string> zoom-label: "100%";
    in-out property <bool> zoom-badge-visible: false;
    in-out property <bool> shortcuts-open: false;
    // True while a wheel zoom is live. Cards keep their full content but use
    // a fixed 1x inner layout and one transform, so zooming never re-lays out
    // text/media and never swaps the visible subtree.
    in-out property <bool> fast-zoom: false;
    // Side panel width + open flag (persisted in `ui.json`; 220..480).
    in-out property <bool> side-panel-open: true;
    in-out property <length> side-panel-width: 280px;
    in-out property <bool> side-panel-resizing: false;
    in-out property <[RulerTick]> ruler-x: [];
    in-out property <[RulerTickImage]> ruler-y: [];
    // Node-level layer popover (the hover bar's `layers` action).
    in-out property <bool> node-layer-open: false;
    in-out property <string> node-layer-header: "";
    in-out property <bool> node-layer-can-up: true;
    in-out property <bool> node-layer-can-down: true;
    in-out property <length> node-layer-x: 0px;
    in-out property <length> node-layer-y: 0px;
    // Plugin canvas integration (Rust owns the plugin host; src/plugin_host.rs).
    // Node creation is the dock's per-type buttons; the plugin manager opens
    // from the library top bar.
    in-out property <bool> plugins-open: false;
    in-out property <string> plugin-tab: "official";
    in-out property <string> plugin-url: "";
    in-out property <bool> plugin-refreshing: false;
    in-out property <string> plugin-message: "";
    in-out property <bool> plugin-message-error: false;
    in-out property <[PluginManagerRow]> plugin-rows: [];
    in-out property <bool> hover-bar-visible: false;
    in-out property <length> hover-bar-x: 0px;
    in-out property <length> hover-bar-y: 0px;
    in-out property <[HoverAction]> hover-actions: [];
    in-out property <bool> selection-visible: false;
    in-out property <length> selection-x: 0px;
    in-out property <length> selection-y: 0px;
    in-out property <length> selection-width: 0px;
    in-out property <length> selection-height: 0px;
    in-out property <string> selection-border: "";
    in-out property <bool> selection-bar-visible: false;
    in-out property <length> selection-bar-x: 0px;
    in-out property <length> selection-bar-y: 0px;
    in-out property <bool> align-menu-open: false;
    in-out property <bool> layout-menu-open: false;
    in-out property <bool> distributable: false;
    in-out property <bool> info-open: false;
    in-out property <string> info-title: "";
    in-out property <string> info-error: "";
    in-out property <bool> info-json: false;
    in-out property <string> info-json-text: "";
    in-out property <[InfoRow]> info-rows: [];
    in-out property <bool> preview-open: false;
    in-out property <string> preview-title: "";
    in-out property <bool> preview-stack: false;
    // Preview media (`image_tools` / `canvas_content::preview_content`): the
    // decoded bitmap, the media info line and the stack gallery rows.
    in-out property <image> preview-image;
    in-out property <string> preview-info: "";
    in-out property <[StackGalleryRow]> preview-rows: [];
    in-out property <int> preview-count: 0;
    // Canvas media import prompt + the image quick-tool dialog
    // (`image_tools::CanvasMedia`).
    // Canvas image quick-tool dialog + the AI-backed image tools
    // (`image_tools::CanvasMedia`).
    in-out property <bool> image-tool-open: false;
    in-out property <ImageToolState> image-tool-state;
    // AI-backed image tools (`image_ai.rs`): OCR / multi-angle / AI upscale /
    // segmentation share one dialog state, dispatched by `kind`.
    in-out property <bool> image-ai-open: false;
    in-out property <ImageAiState> image-ai-state;
    in-out property <[string]> image-ai-variant-options: [];
    in-out property <[string]> image-ai-variant-labels: [];
    in-out property <[string]> image-ai-factor-options: [];
    in-out property <[string]> image-ai-factor-labels: [];

    // AI provider/model config (the settings modal's tabs).
    in-out property <bool> config-open: false;
    in-out property <string> config-tab: "providers";
    in-out property <[ConfigChannelRow]> config-channels: [];
    in-out property <[ConfigOptionRow]> appearance-theme: [];
    in-out property <string> config-theme: "light";
    // Image Attempt workbench (double-click an attempt card).
    in-out property <bool> attempt-open: false;
    in-out property <string> attempt-id: "";
    in-out property <[AttemptTabRow]> attempt-tabs: [];
    in-out property <string> attempt-prompt: "";
    in-out property <string> attempt-model: "";
    in-out property <[string]> attempt-model-options: [];
    in-out property <string> attempt-size: "";
    in-out property <bool> attempt-size-custom: false;
    in-out property <string> attempt-quality: "";
    in-out property <int> attempt-count: 1;
    in-out property <int> attempt-version: 1;
    in-out property <string> attempt-version-text: "1";
    in-out property <string> attempt-intent: "";
    in-out property <string> attempt-reason: "";
    in-out property <bool> attempt-frozen: false;
    in-out property <int> attempt-run-count: 0;
    in-out property <int> attempt-image-count: 0;
    in-out property <image> attempt-image;
    in-out property <bool> attempt-has-image: false;
    in-out property <bool> attempt-has-output: false;
    in-out property <string> attempt-trace: "";
    callback attempt-prompt-edited(string);
    callback attempt-version-edited(string);
    callback attempt-reason-edited(string);
    callback attempt-config-edited(string, string);
    callback attempt-run();
    callback attempt-duplicate();
    callback attempt-extract();
    callback attempt-close();
    callback attempt-tab-picked(string);
    // The Appearance tab's window glass settings (0–100 each): the plate alpha
    // and the captured-desktop blur strength. Rust restores them from `ui.json`
    // and applies every change (`App::glass_setting`).
    in-out property <float> glass-opacity: 80;
    in-out property <float> glass-blur: 100;
    in-out property <bool> local-runtime-available: false;
    in-out property <[LocalModelRow]> local-models: [];
    in-out property <string> local-models-dir: "";
    in-out property <[StorageKindRow]> storage-rows: [];
    in-out property <string> storage-summary: "";
    in-out property <bool> storage-clear-armed: false;
    in-out property <[CostRecordRow]> cost-rows: [];
    in-out property <string> cost-summary: "";
    in-out property <string> cost-generation-id: "";
    in-out property <int> cost-priced-count: 0;
    in-out property <[LogRow]> log-rows: [];
    in-out property <string> logs-filter: "all";
    in-out property <string> logs-category: "all";
    in-out property <[string]> logs-categories: [];
    in-out property <string> config-app-version: "";
    // Navigation + library (Rust owns the state; see crates/app/src/library.rs).
    in-out property <string> view: "library";
    in-out property <[LibraryGroupRow]> library-groups: [];
    in-out property <[ProjectListRow]> library-projects: [];
    in-out property <[SidePanelRow]> side-rows: [];
    in-out property <string> side-group: "";
    in-out property <string> library-group-title: "No project";
    in-out property <bool> library-has-group: false;
    // Active toasts, newest last (`App::notices`). The Rust tick expires them;
    // this list is the whole rendering contract (AntD `message` stacking).
    in-out property <[ToastRow]> notices: [];
    in-out property <bool> export-open: false;
    in-out property <bool> export-import-mode: false;
    in-out property <string> export-title: "";
    in-out property <string> export-path: "";
    in-out property <string> export-hint: "";
    in-out property <string> export-message: "";
    in-out property <bool> export-error: false;
    // Image Studio workspace (Rust owns the state; see crates/app/src/image*.rs).
    in-out property <image> image-canvas-image;
    in-out property <string> image-checker: "";
    in-out property <length> image-checker-x: 0px;
    in-out property <length> image-checker-y: 0px;
    in-out property <length> image-checker-w: 0px;
    in-out property <length> image-checker-h: 0px;
    in-out property <float> image-doc-w: 640;
    in-out property <float> image-doc-h: 360;
    in-out property <float> image-view-k: 1;
    in-out property <length> image-view-x: 0px;
    in-out property <length> image-view-y: 0px;
    in-out property <string> image-grid: "";
    in-out property <string> image-guides: "";
    in-out property <string> image-ants: "";
    in-out property <string> image-ants-alt: "";
    in-out property <string> image-draft: "";
    in-out property <string> image-snap-lines: "";
    in-out property <string> image-path-overlay: "";
    in-out property <string> image-transform: "";
    in-out property <[RulerTick]> image-ruler-x: [];
    in-out property <[RulerTickImage]> image-ruler-y: [];
    in-out property <bool> image-show-rulers: false;
    in-out property <bool> image-snap: true;
    in-out property <[ImageToolRow]> image-tools: [];
    in-out property <string> image-active-tool: "hand";
    in-out property <[ImageLayerRow]> image-layers: [];
    in-out property <[ImageHistoryRow]> image-history: [];
    in-out property <[ImageSwatchGroup]> image-swatches: [];
    in-out property <[ImageParamRow]> image-params: [];
    in-out property <[ImageStyleRow]> image-styles: [];
    in-out property <[string]> image-fonts: [];
    in-out property <bool> image-can-undo: false;
    in-out property <bool> image-can-redo: false;
    in-out property <bool> image-has-selection: false;
    in-out property <bool> image-pan-cursor: false;
    in-out property <string> image-menu: "";
    in-out property <ImagePanels> image-panels: {
        layers: true,
        fx: true,
        history: true,
        properties: true,
        color: true,
    };
    in-out property <bool> image-settings-open: false;
    in-out property <float> image-brush: 24;
    in-out property <float> image-hardness: 80;
    in-out property <float> image-opacity: 100;
