    callback node-view-all(string);
    callback node-info(string);
    // Assets node folder binding: bind/rebind, expand, refresh and drag a file
    // row out onto the canvas (the row passes its root-relative path).
    callback node-asset-bind(string);
    callback node-asset-toggle(string, string);
    callback node-asset-refresh(string);
    callback node-asset-drag(string, string);
    callback node-asset-drag-start(string, string, length, length);
