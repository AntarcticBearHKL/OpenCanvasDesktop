    callback image-filter-apply();
    callback image-filter-cancel();
    callback image-filter-push(float, float);
    callback image-modal-field(string, string);
    callback image-modal-toggle(string);
    callback image-modal-run();
    callback image-modal-close();

    // The blurred desktop snapshot is the bottom layer; the plate below is
    // the white frost over it. The image is a whole-desktop capture pinned by
    // `glass-x/y`, so moving the window only changes this offset.
    if root.glass-backdrop-valid : Image {
        x: root.glass-x;
        y: root.glass-y;
        width: root.glass-w;
        height: root.glass-h;
        source: root.glass-backdrop;
        image-fit: fill;
    }

    // Root surface: the frameless window is rounded by DWM (`glass::round_corners`),
    // and this clipped surface keeps the content inside the same rounded edge.
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-window;
        clip: true;
        // The window plate: the white frost over the captured, blurred
        // desktop. Before the first capture (and when blur is off) the OS
        // transparent-window fallback or the opaque base tone carries the
        // window, so it can never become a black hole.
        background: (root.glass-backdrop-valid || root.backdrop)
            ? Theme.window-tint
            : Theme.background;

    VerticalLayout {
        spacing: 0;

        // No app title bar anywhere: the home screen's header carries the
        // window controls (and is its drag surface), the canvas is edge-to-edge
        // and the studio's own menu bar is its top row.
        Rectangle {
            vertical-stretch: 1;

            LibraryScreen {
                visible: root.view == "library";
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                groups: root.library-groups;
                projects: root.library-projects;
                group-title: root.library-group-title;
                has-group: root.library-has-group;
                maximized: root.window-maximized;
                create-group => {
                    root.library-create-group();
                }
                select-group(id) => {
                    root.library-select-group(id);
                }
                group-action(id, action) => {
                    root.library-group-action(id, action);
                }
                group-name-edited(text) => {
                    root.library-group-name-edited(text);
                }
                create-project => {
                    root.library-create-project();
                }
                project-action(id, action) => {
                    root.library-project-action(id, action);
                }
                project-name-edited(text) => {
                    root.library-project-name-edited(text);
                }
                settings => {
                    root.open-config();
                }
                go-home => {
                    root.go-home();
                }
                minimize => {
                    root.win-minimize();
                }
                maximize-toggle => {
                    root.win-maximize-toggle();
                }
                close => {
                    root.win-close();
                }
                drag-begin => {
                    root.drag-begin();
                }
                drag-tick => {
                    root.drag-tick();
                }
                drag-end => {
                    root.drag-end();
                }
            }

            HorizontalLayout {
                visible: root.view == "editor";
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                spacing: 0;

                SidePanel {
                    open: root.side-panel-open;
                    panel-width: root.side-panel-width;
                    resizing: root.side-panel-resizing;
                    rows: root.side-rows;
                    group-title: root.side-group;
                    open-project(id) => {
                        root.side-panel-open-project(id);
                    }
                    create-project => {
                        root.side-panel-create-project();
                    }
                    go-home => {
                        root.go-home();
                    }
                    right-click => {
                        root.toggle-panel();
                    }
                    project-action(id, action) => {
                        root.side-panel-project-action(id, action);
                    }
                    reorder(id, direction) => {
                        root.side-panel-reorder(id, direction);
                    }
                    resize(kind, x) => {
                        root.side-resize(kind, x);
                    }
                    // A left-drag on the panel background moves the window
                    // through the same manual move as the canvas background.
                    drag-begin => {
                        root.drag-begin();
                    }
                    drag-tick => {
                        root.drag-tick();
                    }
                    drag-end => {
                        root.drag-end();
                    }
                }
            canvas-area := Rectangle {
                horizontal-stretch: 1;
                background: Theme.glass-content;
                clip: true;
                // True between a left-button press on empty background and its
                // release: the window follows the pointer (see `bg-hit`).
                property <bool> window-dragging: false;
                changed width => {
                    root.canvas-resized(self.width, self.height);
                }
                changed height => {
                    root.canvas-resized(self.width, self.height);
                }

                // Background interaction layer: wheel zoom, middle/right-drag
                // pan, left-drag window move (Shift keeps the marquee and
                // Ctrl+right the cut stroke) and the plain click-to-deselect.
                bg-hit := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: root.panning ? grabbing : root.space-held ? grab : default;
                    scroll-event(e) => {
                        root.canvas-scroll(self.mouse-x, self.mouse-y, e.delta-y / 1px);
                        accept
                    }
                    double-clicked => {
                        // Background double-click does nothing: nodes are
                        // created from the dock's node-type buttons.
                    }
                    pointer-event(e) => {
                        let kind = PointerIds.kind-id(e.kind);
                        if (kind == "down") {
                            shortcut-focus.focus();
                        }
                        // The canvas has no title strip: left-drag moves the
                        // window through the same manual move as the top bar.
                        // The Rust handler classifies the press first and sets
                        // `canvas-window-drag` only for empty background, so a
                        // wire click, Shift+left marquee and the middle/right
                        // pan (or Ctrl+right cut) never move the window.
                        root.canvas-pointer(kind, self.mouse-x, self.mouse-y, PointerIds.button-id(e.button), e.modifiers.shift, e.modifiers.control);
                        if (e.button == PointerEventButton.left && root.canvas-window-drag && kind == "down") {
                            canvas-area.window-dragging = true;
                            root.drag-begin();
                        } else if (e.button == PointerEventButton.left && canvas-area.window-dragging && kind == "move") {
                            root.drag-tick();
                        } else if ((kind == "up" || kind == "cancel") && canvas-area.window-dragging) {
                            canvas-area.window-dragging = false;
                            root.drag-end();
                        }
                    }
                }

                // 1. canvas background: the dot grid, then 2. the wires.
                //
                // The grid is a pre-rendered tile (`grid-tile`: `grid-tile-w /
                // grid-step` dots per axis, rasterised once in Rust from
                // `Theme.canvas-dot` at 2.5px) repeated over the canvas by a
                // small lattice of Image elements. The lattice covers one whole
                // tile past every edge, so `Math.mod` returning [0, tile] is
                // always enough. Panning only moves these elements (bindings on
                // `vp-x`/`vp-y`) and zooming does not touch them at all: the
                // spacing is a fixed screen constant, so the dots neither
                // spread nor tighten with the zoom.
                //
                // Dots are 2.5px circles in `Theme.canvas-dot` at the 0.65
                // opacity the old path layer drew at (baked into the tile
                // alpha); the phase snaps to whole pixels, so the dots never
                // shimmer while panning.
                for index in root.grid-indices : Image {
                    visible: !root.legacy-grid;
                    x: (root.grid-phase-x + (Math.mod(index, root.grid-cols) - 1) * root.grid-tile-w) * 1px;
                    y: (root.grid-phase-y + (Math.floor(index / root.grid-cols) - 1) * root.grid-tile-h) * 1px;
                    width: root.grid-tile-w * 1px;
                    height: root.grid-tile-h * 1px;
                    source: root.grid-tile;
                    image-fit: fill;
                }
                // Legacy dot grid: one world-space Path, re-tessellated on
                // every viewport change (`OC_LEGACY_GRID=1`; the perf tests
                // measure this against the tiled background).
                WorldPath {
                    visible: root.legacy-grid;
                    commands: root.grid;
                    stroke: Theme.canvas-dot;
                    stroke-width: 2.5px;
                    stroke-line-cap: round;
                    opacity: 0.65;
                    viewport-scale: root.scale;
                    viewport-x: root.vp-x;
                    viewport-y: root.vp-y;
                }
                WorldPath {
                    commands: root.wires;
                    stroke: Theme.node-faint;
                    stroke-width: 2px;
                    opacity: 0.82;
                    viewport-scale: root.scale;
                    viewport-x: root.vp-x;
                    viewport-y: root.vp-y;
                }
                // Selected wire (canvas-connections.tsx:44-51: activeStroke at 3px).
                WorldPath {
                    commands: root.selected-wire;
                    stroke: Theme.node-active-stroke;
                    stroke-width: 3px;
                    viewport-scale: root.scale;
                    viewport-x: root.vp-x;
                    viewport-y: root.vp-y;
                }
                // Selected edge explanation pill. It sits in screen space so
                // its text stays legible at every zoom.
                if root.edge-reason-visible : Rectangle {
                    x: root.edge-reason-x;
                    y: root.edge-reason-y;
                    width: edge-label.preferred-width + 20px;
                    height: 30px;
                    border-radius: Theme.radius-md;
                    background: Theme.glass-panel;
                    border-width: 1px;
                    border-color: Theme.glass-panel-border;
                    z: 20;

                    edge-label := Text {
                        x: 10px;
                        y: 0px;
                        width: parent.width - 20px;
                        height: 100%;
                        text: root.edge-reason-text;
                        font-size: 11px;
                        color: Theme.node-text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // 3. active connection (screen space, under the nodes like the
                //    web's SVG layer)
                ScreenPath {
                    commands: root.active-wire;
                    stroke: Theme.node-active-stroke;
                    stroke-width: 2px;
                }

                // Cut-tool stroke (project.tsx:1911-1912: selectionStroke, 2px).
                ScreenPath {
                    commands: root.cut-stroke;
                    stroke: Theme.canvas-selection-stroke;
                    stroke-width: 2px;
                }

                // 4. nodes
                for node in root.nodes : NodeCard {
                    node-id: node.id;
                    kind: node.kind;
                    title: node.title;
                    body: node.body;
                    body-size: node.body-size;
                    body-color: node.body-color;
                    body-colored: node.body-colored;
                    media: node.media;
                    plugin-kind: node.plugin-kind;
                    plugin-text: node.plugin-text;
                    plugin-raw: node.plugin-raw;
                    plugin-empty: node.plugin-empty;
                    plugin-editing: node.plugin-editing;
                    plugin-interactive: node.plugin-interactive;
                    plugin-transparent: node.plugin-transparent;
                    plugin-bg: node.plugin-bg;
                    plugin-image: node.plugin-image;
                    plugin-palette-open: node.plugin-palette-open;
                    plugin-palette: node.plugin-palette;
                    has-source: node.has-source;
                    has-target: node.has-target;
                    content-image: node.content-image;
                    content-fit: node.content-fit;
                    content-empty: node.content-empty;
                    status: node.status;
                    error-text: node.error-text;
                    status-label: node.status-label;
                    info: node.info;
                    media-info: node.media-info;
                    stack-cover: node.stack-cover;
                    stack: node.stack;
                    stack-count: node.stack-count;
                    stack-count-label: node.stack-count-label;
                    stack-cover-error: node.stack-cover-error;
                    assets: node.assets;
                    asset-count: node.asset-count;
                    asset-count-label: node.asset-count-label;
                    asset-source: node.asset-source;
                    asset-tree: node.asset-tree;
                    asset-bound: node.asset-bound;
                    asset-folder: node.asset-folder;
                    asset-error: node.asset-error;
                    duration: node.duration;
                    batch-count: node.batch-count;
                    batch-label: node.batch-label;
                    batch: node.batch;
                    related: node.related;
                    editing: node.editing;
                    edit-text: node.edit-text;
                    editing-title: node.editing-title;
                    title-draft: node.title-draft;
                    // Viewport culling: off-screen cards skip layout and paint.
                    // The margin keeps the title slot and shadows alive at the
                    // edge while the card itself is just outside.
                    visible: node.world-x * root.scale + root.vp-x < canvas-area.width + 120px
                        && (node.world-x + node.width) * root.scale + root.vp-x > -120px
                        && node.world-y * root.scale + root.vp-y < canvas-area.height + 120px
                        && (node.world-y + node.height) * root.scale + root.vp-y > -120px;
                    canvas-x: node.world-x * root.scale + root.vp-x;
                    canvas-y: node.world-y * root.scale + root.vp-y;
                    // Keep the same NodeCard and its content in both modes:
                    // only the geometry changes. During a wheel zoom the card
                    // is laid out at 1x and scaled as one transform; the cold
                    // pass restores per-card layout for crisp text.
                    card-width: root.fast-zoom ? node.width : node.width * root.scale;
                    card-height: root.fast-zoom ? node.height : node.height * root.scale;
                    scale: root.fast-zoom ? 1.0 : root.scale;
                    transform-scale-x: root.fast-zoom ? root.scale : 1.0;
                    transform-scale-y: root.fast-zoom ? root.scale : 1.0;
                    transform-origin: {
                        x: 0px,
                        y: 0px,
                    };
                    enter: node.enter;
                    selected: node.selected;
                    locked: node.locked;
                    drag-active: root.drag-active;
                    connect-target: root.connect-target-id == node.id;
                    drop-target: root.drop-target-id == node.id;
                    slot-drop: root.drop-target-id == node.id ? root.drop-slot : "";
                    slot-first: node.slot-first;
                    slot-last: node.slot-last;
                    ref-slot-count: node.ref-slot-count;
                    ref-slot-titles: node.ref-slot-titles;
                    video-mode: node.video-mode;
                    prompt-caret: node.prompt-caret;
                    prompt-caret-seq: node.prompt-caret-seq;
                    prompt-editing: node.prompt-editing;
                    ref-images: node.ref-images;
                    mode: node.mode;
                    model: node.model;
                    model-brand: node.model-brand;
                    settings-label: node.settings-label;
                    generation-settings: node.generation-settings;
                    open-popover: node.open-popover;
                    can-generate: node.can-generate;
                    running: node.running;
                    attempt-version: node.attempt-version;
                    attempt-title: node.attempt-title;
                    attempt-reason: node.attempt-reason;
                    attempt-frozen: node.attempt-frozen;
                    attempt-current: node.attempt-current;
                    attempt-run-count: node.attempt-run-count;
                    attempt-image-count: node.attempt-image-count;
                    attempt-trace-count: node.attempt-trace-count;
                    plugin-text-edited(id, text) => {
                        root.plugin-text-edited(id, text);
                    }
                    plugin-palette-pick(id, index) => {
                        root.plugin-palette-pick(id, index);
                    }
                    node-pointer(id, kind, x, y, button, shift) => {
                        if (kind == "down") {
                            shortcut-focus.focus();
                        }
                        root.node-pointer(id, kind, x, y, button, shift);
                    }
                    node-scroll(id, x, y, delta-y) => {
                        root.canvas-scroll(x, y, delta-y);
                    }
                    resize-pointer(corner, kind, x, y) => {
                        root.resize-pointer(node.id, corner, kind, x, y);
                    }
                    connect-pointer(handle, kind, x, y) => {
                        root.connect-pointer(node.id, handle, kind, x, y);
                    }
                    node-hover(id, hovered) => {
                        root.node-hover(id, hovered);
                    }
                    node-double-click(id) => {
                        root.node-double-click(id);
                    }
                    node-retry(id) => {
                        root.node-retry(id);
                    }
                    node-view-all(id) => {
                        root.node-view-all(id);
                    }
                    node-info(id) => {
                        root.node-info(id);
                    }
                    node-asset-bind(id) => {
                        root.node-asset-bind(id);
                    }
                    node-asset-toggle(id, path) => {
                        root.node-asset-toggle(id, path);
                    }
                    node-asset-refresh(id) => {
                        root.node-asset-refresh(id);
                    }
                    node-asset-drag(id, path) => {
                        root.node-asset-drag(id, path);
                    }
                    node-asset-drag-start(id, path, x, y) => {
                        root.node-asset-drag-start(id, path, x, y);
                    }
                    node-asset-drag-move(id, x, y) => {
                        root.node-asset-drag-move(id, x, y);
                    }
                    node-asset-drag-end(id) => {
                        root.node-asset-drag-end(id);
                    }
                    node-edit-begin(id, target) => {
                        root.node-edit-begin(id, target);
                    }
                    node-edit-change(id, text) => {
                        root.node-edit-change(id, text);
                    }
                    node-edit-commit(id) => {
                        root.node-edit-commit(id);
                    }
                    node-edit-cancel(id) => {
                        root.node-edit-cancel(id);
                    }
                    node-video-mode(id, mode) => {
                        root.node-video-mode(id, mode);
                    }
                    node-video-slots(id, delta) => {
                        root.node-video-slots(id, delta);
                    }
                    node-prompt-edited(id, text, caret) => {
                        root.node-prompt-edited(id, text, caret);
                    }
                    node-prompt-blur(id) => {
                        root.node-prompt-blur(id);
                    }
                    node-prompt-edit-cancel(id) => {
                        root.node-prompt-edit-cancel(id);
                    }
                    node-popover(id, kind) => {
                        root.node-popover(id, kind);
                    }
                    node-setting(id, key, value) => {
                        root.node-setting(id, key, value);
                    }
                    node-generate(id) => {
                        root.node-generate(id);
                    }
                    node-text-option(id, option, action) => {
                        root.node-text-option(id, option, action);
                    }
                    node-ref-remove(id, image) => {
                        root.node-ref-remove(id, image);
                    }
                }

                // 5. snap guides (z-45) and 6. the dock (z-50)
                ScreenPath {
                    commands: root.guides;
                    stroke: Theme.selection-blue;
                    stroke-width: 1px;
                }

                dock := DockBar {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 20px;
                    z: 50;
                    can-undo: root.can-undo;
                    can-redo: root.can-redo;
                    has-selection: root.has-selection;
                    panel-open: root.side-panel-open;
                    toggle-panel => {
                        root.toggle-panel();
                    }
                    create-node(type-id) => {
                        root.create-node(type-id);
                    }
                    undo => {
                        root.undo();
                    }
                    redo => {
                        root.redo();
                    }
                    delete-selection => {
                        root.delete-selection();
                    }
                }

                // Zoom read-out: bare text in the canvas' bottom-right corner,
                // with the same 16px padding on the right and the bottom edges
                // (no plate, no border, no shadow - it is an indicator, not a
                // control). Rust raises it on every zoom change and drops it
                // again after ~900ms, so the two animated opacities are a 120ms
                // fade-in and a 400ms fade-out. It takes no pointer events.
                Rectangle {
                    x: parent.width - self.width - 16px;
                    y: parent.height - self.height - 16px;
                    width: zoom-pill-text.preferred-width;
                    height: 20px;
                    z: 55;
                    background: transparent;
                    opacity: root.zoom-badge-visible ? 1 : 0;
                    animate opacity {
                        // 110ms in / 420ms out on the shared motion steps.
                        duration: root.zoom-badge-visible ? Theme.motion-hover : Theme.motion-enter;
                        easing: ease-out;
                    }

                    zoom-pill-text := Text {
                        width: 100%;
                        text: root.zoom-label;
                        font-size: 15px;
                        font-weight: 500;
                        color: Theme.node-muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }

                Rulers {
                    ticks-x: root.ruler-x;
                    labels-y: root.ruler-y;
                }

                // Selection bounds (z-65) and the floating bars (z-70).
                SelectionToolbar {
                    bounds-visible: root.selection-visible;
                    rect-x: root.selection-x;
                    rect-y: root.selection-y;
                    rect-width: root.selection-width;
                    rect-height: root.selection-height;
                    border: root.selection-border;
                    bar-visible: root.selection-bar-visible;
                    bar-x: root.selection-bar-x;
                    bar-y: root.selection-bar-y;
                    align-open: root.align-menu-open;
                    layout-open: root.layout-menu-open;
                    distributable: root.distributable;
                    menu(id) => {
                        root.selection-menu(id);
                    }
                    align(axis) => {
                        root.align-action(axis);
                    }
                    delete-selection => {
                        root.delete-selection();
                    }
                }

                HoverBar {
                    visible: root.hover-bar-visible;
                    anchor-x: root.hover-bar-x;
                    anchor-y: root.hover-bar-y;
                    canvas-width: canvas-area.width;
                    canvas-height: canvas-area.height;
                    scale: root.scale;
                    actions: root.hover-actions;
                    action(id) => {
                        root.hover-action(id);
                    }
                    bar-hover(hovered) => {
                        root.bar-hover(hovered);
                    }
                    bar-press(pressed) => {
                        root.bar-press(pressed);
                    }
                }

                // Node-level layer popover (hover bar `layers`): layer count and
                // the node's own z-order moves, hanging under the bar (z-75).
                NodeLayerPopover {
                    visible: root.node-layer-open;
                    anchor-x: root.node-layer-x;
                    anchor-y: root.node-layer-y;
                    canvas-width: canvas-area.width;
                    canvas-height: canvas-area.height;
                    header: root.node-layer-header;
                    can-up: root.node-layer-can-up;
                    can-down: root.node-layer-can-down;
                    z: 75;
                    move(direction) => {
                        root.node-layer-move(direction);
                    }
                    close => {
                        root.node-layer-close();
                    }
                }

                // 8. marquee (z-100, above every overlay in the web)
                Rectangle {
                    visible: root.marquee-visible;
                    x: root.marquee-x;
                    y: root.marquee-y;
                    width: root.marquee-width;
                    height: root.marquee-height;
                    background: Theme.canvas-selection-fill;
                    z: 100;
                }
                ScreenPath {
                    commands: root.marquee-border;
                    stroke: Theme.canvas-selection-stroke;
                    stroke-width: 1px;
                    opacity: 0.55;
                    z: 100;
                }

                // Hold-to-home: a Zelda-stamina ring at the press point. The
                // track is always drawn; the accent arc fills clockwise from
                // 12 o'clock and completes at HOME_HOLD_MS (900ms).
                if root.home-hold-visible : Rectangle {
                    x: root.home-hold-x - 26px;
                    y: root.home-hold-y - 26px;
                    width: 52px;
                    height: 52px;
                    z: 120;
                    background: transparent;

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 26px;
                        background: Theme.foreground.with-alpha(0.08 + 0.04 * root.home-hold-progress);
                    }
                    Rectangle {
                        x: 5px;
                        y: 5px;
                        width: 42px;
                        height: 42px;
                        border-radius: 21px;
                        background: transparent;
                        border-width: 3px;
                        border-color: Theme.foreground.with-alpha(0.22 + 0.10 * root.home-hold-progress);
                    }
                    Path {
                        x: 5px;
                        y: 5px;
                        width: 42px;
                        height: 42px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: root.home-hold-arc;
                        fill: transparent;
                        stroke-width: 2.6px;
                        stroke-line-cap: round;
                        stroke: Theme.node-accent;
                    }
                    Path {
                        x: 18px;
                        y: 18px;
                        width: 16px;
                        height: 16px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.home;
                        fill: transparent;
                        stroke-width: 2px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                        stroke: Theme.foreground;
                    }
                }
            }
            }

            // Image Studio workspace (view == "image"): own studio top bar,
            // tool rail, dock columns and board; Rust owns every value.
            image-ws := ImageStudio {
                visible: root.view == "image";
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                canvas-image: root.image-canvas-image;
                checker: root.image-checker;
                checker-x: root.image-checker-x;
                checker-y: root.image-checker-y;
                checker-w: root.image-checker-w;
                checker-h: root.image-checker-h;
                doc-w: root.image-doc-w;
                doc-h: root.image-doc-h;
                view-k: root.image-view-k;
                view-x: root.image-view-x;
                view-y: root.image-view-y;
                grid: root.image-grid;
                guides: root.image-guides;
                ants: root.image-ants;
                ants-alt: root.image-ants-alt;
                draft: root.image-draft;
                snap-lines: root.image-snap-lines;
                path-overlay: root.image-path-overlay;
                transform-handles: root.image-transform;
                ruler-x: root.image-ruler-x;
                ruler-y: root.image-ruler-y;
                show-rulers: root.image-show-rulers;
                snap: root.image-snap;
                tools: root.image-tools;
                active-tool: root.image-active-tool;
                layers: root.image-layers;
                history: root.image-history;
                swatches: root.image-swatches;
                params: root.image-params;
                styles: root.image-styles;
                fonts: root.image-fonts;
                can-undo: root.image-can-undo;
                can-redo: root.image-can-redo;
                has-selection: root.image-has-selection;
                pan-cursor: root.image-pan-cursor;
                menu: root.image-menu;
                panels: root.image-panels;
                settings-open: root.image-settings-open;
                brush: root.image-brush;
                hardness: root.image-hardness;
                brush-opacity: root.image-opacity;
                tolerance: root.image-tolerance;
                feather: root.image-feather;
                contiguous: root.image-contiguous;
                sample-all: root.image-sample-all;
                antialias: root.image-antialias;
                gradient-radial: root.image-gradient-radial;
                gradient-reverse: root.image-gradient-reverse;
                shape-kind: root.image-shape-kind;
                shape-fill: root.image-shape-fill;
                stroke-width: root.image-stroke-width;
                fg-color: root.image-color;
                bg-color: root.image-bg-color;
                fg-hex: root.image-color-hex;
                bg-hex: root.image-bg-hex;
                slot: root.image-slot;
                hue: root.image-hue;
                sat: root.image-sat;
                val: root.image-val;
                red: root.image-red;
                green: root.image-green;
                blue: root.image-blue;
                active-kind: root.image-active-kind;
                layer-name: root.image-layer-name;
                layer-x: root.image-layer-x;
                layer-y: root.image-layer-y;
                layer-w: root.image-layer-w;
                layer-h: root.image-layer-h;
                layer-rotation: root.image-layer-rotation;
                layer-opacity: root.image-layer-opacity;
                layer-blend: root.image-layer-blend;
                adjustment: root.image-adjustment;
                text-content: root.image-text-content;
                text-family: root.image-text-family;
                board-w: root.image-board;
                board-h: root.image-board-h;
                ratio: root.image-ratio;
                resolution: root.image-resolution;
                board-background: root.image-background;
                background-opacity: root.image-background-opacity;
                export-open: root.image-export-open;
                export-path: root.image-export-path;
                export-message: root.image-export-message;
                export-error: root.image-export-error;
                guide-draft: root.image-guide-draft;
                transform-mode: root.image-transform-mode;
                mask-view: root.image-mask-view;
                layer-has-mask: root.image-layer-has-mask;
                layer-can-add-mask: root.image-layer-can-add-mask;
                layer-can-apply-mask: root.image-layer-can-apply-mask;
                layer-mask-target: root.image-layer-mask-target;
                text-rows: root.image-text-rows;
                text-edit-on: root.image-text-edit-on;
                text-edit-draft: root.image-text-edit-draft;
                text-edit-x: root.image-text-edit-x;
                text-edit-y: root.image-text-edit-y;
                text-edit-w: root.image-text-edit-w;
                text-edit-h: root.image-text-edit-h;
                import-open: root.image-import-open;
                import-path: root.image-import-path;
                import-message: root.image-import-message;
                import-error: root.image-import-error;
                psd-export-open: root.image-psd-export-open;
                psd-export-path: root.image-psd-export-path;
                psd-export-message: root.image-psd-export-message;
                psd-export-error: root.image-psd-export-error;
                channels: root.image-channels;
                channel-r: root.image-channel-r;
                channel-g: root.image-channel-g;
                channel-b: root.image-channel-b;
                channel-view: root.image-channel-view;
                paths: root.image-paths;
                path-can-paint: root.image-path-can-paint;
                actions: root.image-actions;
                recording: root.image-recording;
                recorded: root.image-recorded;
                assets: root.image-assets;
                asset-search: root.image-asset-search;
                adjustments: root.image-adjustments;
                gradients: root.image-gradients;
                gradient-stops: root.image-gradient-stops;
                editor-stops: root.image-editor-stops;
                gradient-edit-strip: root.image-gradient-edit-strip;
                gradient-name: root.image-gradient-name;
                gradient-stop-selected: root.image-gradient-stop-selected;
                patterns: root.image-patterns;
                pattern-can-define: root.image-pattern-can-define;
                brushes: root.image-brushes;
                brush-preview: root.image-brush-preview;
                brush-spacing: root.image-brush-spacing;
                brush-scatter: root.image-brush-scatter;
                brush-angle: root.image-brush-angle;
                brush-roundness: root.image-brush-roundness;
                brush-dynamics: root.image-brush-dynamics;
                brush-texture: root.image-brush-texture;
                editor-visible: root.image-editor-visible;
                editor-title: root.image-editor-title;
                editor-rows: root.image-editor-rows;
                curve-points: root.image-curve-points;
                curve-path: root.image-curve-path;
                editor-stops-strip: root.image-editor-stops-strip;
                editor-stop-selected: root.image-editor-stop-selected;
                filter-open: root.image-filter-open;
                filter-label: root.image-filter-label;
                filter-params: root.image-filter-params;
                filter-preview: root.image-filter-preview;
                filter-warning: root.image-filter-warning;
                filter-liquify: root.image-filter-liquify;
                filter-menu-rows: root.filter-menu-rows;
                modal-open: root.image-modal-open;
                modal-mode: root.image-modal-mode;
                modal-a: root.image-modal-a;
                modal-b: root.image-modal-b;
                modal-constrain: root.image-modal-constrain;
                modal-anchor: root.image-modal-anchor;
                modal-angle: root.image-modal-angle;
                modal-dx: root.image-modal-dx;
                modal-dy: root.image-modal-dy;
                modal-scale-x: root.image-modal-scale-x;
                modal-scale-y: root.image-modal-scale-y;
                modal-rotation: root.image-modal-rotation;
                modal-skew-x: root.image-modal-skew-x;
                modal-skew-y: root.image-modal-skew-y;
                modal-message: root.image-modal-message;
                home => {
                    root.go-home();
                }
                drag-begin => {
                    root.drag-begin();
                }
                drag-tick => {
                    root.drag-tick();
                }
                drag-end => {
                    root.drag-end();
                }
                action(id) => {
                    root.image-action(id);
                }
                tool(id) => {
                    root.image-tool(id);
                }
                toggle(id) => {
                    root.image-toggle(id);
                }
                slider(key, value) => {
                    root.image-slider(key, value);
                }
                layer-pick(id) => {
                    root.image-layer-pick(id);
                }
                layer-action(action, id) => {
                    root.image-layer-action(action, id);
                }
                layer-opacity-changed(value) => {
                    root.image-layer-opacity-changed(value);
                }
                blend-changed(id) => {
                    root.image-layer-blend-changed(id);
                }
                layer-name-edited(text) => {
                    root.image-layer-name-edited(text);
                }
                history-pick(index) => {
                    root.image-history-pick(index);
                }
                color-field(key, value) => {
                    root.image-color-field(key, value);
                }
                color-pick(hex) => {
                    root.image-color-pick(hex);
                }
                swatch-add => {
                    root.image-swatch-add();
                }
                swatch-remove(index) => {
                    root.image-swatch-remove(index);
                }
                color-swap => {
                    root.image-color-swap();
                }
                color-reset => {
                    root.image-color-reset();
                }
                slot-pick(id) => {
                    root.image-slot-pick(id);
                }
                prop-field(key, value) => {
                    root.image-prop-field(key, value);
                }
                param-set(key, value) => {
                    root.image-param-set(key, value);
                }
                shape-pick(id) => {
                    root.image-shape-pick(id);
                }
                font-pick(family) => {
                    root.image-font-pick(family);
                }
                settings-pick(key, value) => {
                    root.image-settings-pick(key, value);
                }
                board-apply => {
                    root.image-board-apply();
                }
                canvas-pointer(kind, x, y, button, shift, alt) => {
                    root.image-canvas-pointer(kind, x, y, button, shift, alt);
                }
                canvas-scroll(x, y, delta) => {
                    root.image-canvas-scroll(x, y, delta);
                }
                canvas-double-click(x, y) => {
                    root.image-canvas-double-click(x, y);
                }
                key(text, ctrl, shift) => {
                    root.image-key(text, ctrl, shift);
                }
                key-up(text) => {
                    root.image-key-up(text);
                }
                export => {
                    root.image-export();
                }
                export-path-edited(path) => {
                    root.image-export-path-edited(path);
                }
                export-run => {
                    root.image-export-run();
                }
                export-close => {
                    root.image-export-close();
                }
                guide-drag(axis, x, y) => {
                    root.image-guide-drag(axis, x, y);
                }
                guide-move(x, y) => {
                    root.image-guide-move(x, y);
                }
                guide-drop(x, y) => {
                    root.image-guide-drop(x, y);
                }
                mask-action(action) => {
                    root.image-mask-action(action);
                }
                mask-target(layer, target, view) => {
                    root.image-mask-target(layer, target, view);
                }
                text-set(key, value) => {
                    root.image-text-set(key, value);
                }
                text-text(key, value) => {
                    root.image-text-text(key, value);
                }
                text-option(key, value) => {
                    root.image-text-option(key, value);
                }
                text-choice(key, index) => {
                    root.image-text-choice(key, index);
                }
                text-check(key, value) => {
                    root.image-text-check(key, value);
                }
                text-edit-changed(text) => {
                    root.image-text-edit-changed(text);
                }
                text-edit-commit(text) => {
                    root.image-text-edit-commit(text);
                }
                text-edit-cancel => {
                    root.image-text-edit-cancel();
                }
                import-path-edited(path) => {
                    root.image-import-path-edited(path);
                }
                import-run => {
                    root.image-import-run();
                }
                import-close => {
                    root.image-import-close();
                }
                psd-export-path-edited(path) => {
                    root.image-psd-export-path-edited(path);
                }
                psd-export-run => {
                    root.image-psd-export-run();
                }
                psd-export-close => {
                    root.image-psd-export-close();
                }
                channel-action(action, id) => {
                    root.image-channel-action(action, id);
                }
                path-action(action, id) => {
                    root.image-path-action(action, id);
                }
                actions-panel(action, id) => {
                    root.image-actions-panel(action, id);
                }
                asset-action(action, id) => {
                    root.image-asset-action(action, id);
                }
                asset-drop(id, x, y) => {
                    root.image-asset-drop(id, x, y);
                }
                assets-refresh => {
                    root.image-assets-refresh();
                }
                asset-search-edited(text) => {
                    root.image-asset-search-edited(text);
                }
                panel-name-edited(text) => {
                    root.image-panel-name-edited(text);
                }
                adjustment-create(id) => {
                    root.image-adjustment-create(id);
                }
                gradient-action(action, id) => {
                    root.image-gradient-action(action, id);
                }
                pattern-action(action, id) => {
                    root.image-pattern-action(action, id);
                }
                brush-action(action, id) => {
                    root.image-brush-action(action, id);
                }
                brush-slider(key, value) => {
                    root.image-brush-slider(key, value);
                }
                editor-set(key, value) => {
                    root.image-editor-set(key, value);
                }
                editor-text(key, value) => {
                    root.image-editor-text(key, value);
                }
                editor-option(key, value) => {
                    root.image-editor-option(key, value);
                }
                editor-check(key, value) => {
                    root.image-editor-check(key, value);
                }
                curve-add(x, y) => {
                    root.image-curve-add(x, y);
                }
                curve-move(index, x, y) => {
                    root.image-curve-move(index, x, y);
                }
                curve-delete(index) => {
                    root.image-curve-delete(index);
                }
                editor-stop-add => {
                    root.image-editor-stop-add();
                }
                editor-stop-select(index) => {
                    root.image-editor-stop-select(index);
                }
                editor-stop-remove(index) => {
                    root.image-editor-stop-remove(index);
                }
                editor-stop-color(index, hex) => {
                    root.image-editor-stop-color(index, hex);
                }
                editor-stop-pos(index, value) => {
                    root.image-editor-stop-pos(index, value);
                }
                filter-param(key, value) => {
                    root.image-filter-param(key, value);
                }
                filter-param-text(key, value) => {
                    root.image-filter-param-text(key, value);
                }
                filter-reset => {
                    root.image-filter-reset();
                }
                filter-apply => {
                    root.image-filter-apply();
                }
                filter-cancel => {
                    root.image-filter-cancel();
                }
                filter-push(x, y) => {
                    root.image-filter-push(x, y);
                }
                modal-field(key, value) => {
                    root.image-modal-field(key, value);
                }
                modal-toggle(key) => {
                    root.image-modal-toggle(key);
                }
                modal-run => {
                    root.image-modal-run();
                }
                modal-close => {
                    root.image-modal-close();
                }
            }
        }
    }

    // Toasts (AntD `message`): the stack Rust owns (`App::notices`), newest at
    // the bottom, each auto-dismissed by the Rust tick and dismissable here.
    // `z: 130` keeps the stack above every workspace (the studios are declared
    // after this block); modals carry a higher `z` and still win.
    if root.notices.length > 0 : VerticalLayout {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 96px;
        width: max(200px, toast-column.preferred-width);
        spacing: 6px;
        alignment: center;
        z: 130;

        toast-column := VerticalLayout {
            width: 100%;
            spacing: 6px;
            alignment: center;

            for toast in root.notices : toast-card := Rectangle {
                width: toast-row.preferred-width + 16px;
                height: 36px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: toast.error ? Theme.node-danger : Theme.glass-panel-border;
                background: Theme.glass-panel-strong;
                // AntD message enter: fade + 4px slide-down. The exit is owned
                // by Rust (the row leaves the model on its deadline), so it
                // cannot animate here.
                property <bool> shown: false;
                opacity: toast-card.shown ? 1 : 0;
                animate opacity {
                    duration: Theme.motion-popover;
                    easing: ease-out;
                }
                init => {
                    toast-card.shown = true;
                }

                toast-row := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 4px;
                    spacing: 6px;
                    alignment: center;
                    cross-axis-alignment: center;

                    Text {
                        text: toast.text;
                        font-size: 12px;
                        font-weight: 500;
                        color: toast.error ? Theme.node-danger : Theme.foreground;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: toast-close.has-hover ? Theme.border-strong : transparent;
                        background: toast-close.has-hover ? Theme.hover : transparent;
                        animate background {
                            duration: Theme.motion-hover;
                            easing: ease-out;
                        }
                        animate border-color {
                            duration: Theme.motion-hover;
                            easing: ease-out;
                        }

                        toast-close := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.notice-dismiss(toast.id);
                            }
                        }
                        Path {
                            x: 6px;
                            y: 6px;
                            width: 12px;
                            height: 12px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: Icons.close;
                            fill: transparent;
                            stroke-width: 2px;
                            stroke-line-cap: round;
                            stroke: Theme.node-muted;
                        }
                    }
                }
            }
        }
    }

    // Modal stack (AntD renders these at body level): scrim + panel above the
    // whole shell, including the top bar.
    if root.info-open : NodeInfoModal {
        title: root.info-title;
        rows: root.info-rows;
        error: root.info-error;
        json: root.info-json;
        json-text: root.info-json-text;
        set-json(value) => {
            root.info-view(value);
        }
        close => {
            root.modal-close();
        }
    }
    if root.preview-open && !root.preview-stack : ImageFocusModal {
        image: root.preview-image;
        download(id) => {
            root.preview-download(id);
        }
        copy(id) => {
            root.preview-copy(id);
        }
        close => {
            root.modal-close();
        }
    }
    if root.preview-open && root.preview-stack : ImagePreviewModal {
        title: root.preview-title;
        stack: true;
        image: root.preview-image;
        info: root.preview-info;
        rows: root.preview-rows;
        count: root.preview-count;
        download(id) => {
            root.preview-download(id);
        }
        copy(id) => {
            root.preview-copy(id);
        }
        stack-action(id, action) => {
            root.stack-action(id, action);
        }
        close => {
            root.modal-close();
        }
    }
    if root.image-tool-open : ImageToolModal {
        state: root.image-tool-state;
        pick(key, value) => {
            if (key == "ratio" && root.image-tool-state.kind == "analysis") {
                root.image-tool-ratio(value);
            } else {
                root.image-tool-pick(key, value);
            }
        }
        field(key, value) => {
            root.image-tool-field(key, value);
        }
        pointer(kind, x, y) => {
            root.image-tool-pointer(kind, x, y);
        }
        suggest => {
            root.image-tool-suggest();
        }
        reset => {
            root.image-tool-reset();
        }
        apply => {
            root.image-tool-apply();
        }
        close => {
            root.image-tool-close();
        }
    }
    // AI-backed image tools: OCR / multi-angle / AI upscale / segmentation.
    if root.image-ai-open : ImageAiModal {
        state: root.image-ai-state;
        variant-options: root.image-ai-variant-options;
        variant-labels: root.image-ai-variant-labels;
        factor-options: root.image-ai-factor-options;
        factor-labels: root.image-ai-factor-labels;
        field(key, value) => {
            root.image-ai-field(key, value);
        }
        pick(key, value) => {
            root.image-ai-pick(key, value);
        }
        cancel => {
            root.image-ai-cancel();
        }
        apply => {
            root.image-ai-apply();
        }
        close => {
            root.image-ai-close();
        }
    }
    if root.export-open : ExportImportModal {
        title: root.export-title;
        import-mode: root.export-import-mode;
        hint: root.export-hint;
        path: root.export-path;
        message: root.export-message;
        error: root.export-error;
        path-edited(path) => {
            root.export-path-edited(path);
        }
        run => {
            root.export-run();
        }
        close => {
            root.export-close();
        }
    }

    if root.config-open : ConfigModal {
        tab: root.config-tab;
        channels: root.config-channels;
        appearance-theme: root.appearance-theme;
        config-theme: root.config-theme;
        glass-opacity: root.glass-opacity;
        glass-blur: root.glass-blur;
        local-runtime-available: root.local-runtime-available;
        local-models: root.local-models;
        local-models-dir: root.local-models-dir;
        storage-rows: root.storage-rows;
        storage-summary: root.storage-summary;
        storage-clear-armed: root.storage-clear-armed;
        cost-rows: root.cost-rows;
        cost-summary: root.cost-summary;
        cost-generation-id: root.cost-generation-id;
        cost-priced-count: root.cost-priced-count;
        log-rows: root.log-rows;
        logs-filter: root.logs-filter;
        logs-category: root.logs-category;
        logs-categories: root.logs-categories;
        app-version: root.config-app-version;
        close => {
            root.config-close();
        }
        tab-pick(tab) => {
            root.config-tab-pick(tab);
        }
        channel-field(id, field, value) => {
            root.config-channel-field(id, field, value);
        }
        option-pick(kind, value) => {
            root.config-option-pick(kind, value);
        }
        glass-setting(kind, value) => {
            root.glass-setting(kind, value);
        }
        local-refresh => {
            root.config-local-refresh();
        }
        local-reveal => {
            root.config-local-reveal();
        }
        storage-refresh => {
            root.config-storage-refresh();
        }
        storage-reveal => {
            root.config-storage-reveal();
        }
        storage-clear => {
            root.config-storage-clear();
        }
        cost-clear => {
            root.config-cost-clear();
        }
        cost-id-edited(value) => {
            root.config-cost-id-edited(value);
        }
        cost-lookup => {
            root.config-cost-lookup();
        }
        log-filter-pick(filter) => {
            root.config-logs-filter(filter);
        }
        log-category-pick(category) => {
            root.config-logs-category(category);
        }
        log-toggle(key) => {
            root.config-logs-toggle(key);
        }
        logs-copy => {
            root.config-logs-copy();
        }
        logs-download => {
            root.config-logs-download();
        }
        logs-clear => {
            root.config-logs-clear();
        }
        open-plugins => {
            root.open-plugins();
        }
    }

    if root.plugins-open : PluginManagerModal {
        tab: root.plugin-tab;
        url: root.plugin-url;
        message: root.plugin-message;
        message-error: root.plugin-message-error;
        rows: root.plugin-rows;
        refreshing: root.plugin-refreshing;
        tab-pick(tab) => {
            root.plugin-tab-pick(tab);
        }
        refresh => {
            root.plugin-refresh();
        }
        url-edited(text) => {
            root.plugin-url-edited(text);
        }
        install => {
            root.plugin-install();
        }
        install-row(url) => {
            root.plugin-install-row(url);
        }
        toggle(id, enabled) => {
            root.plugin-toggle(id, enabled);
        }
        uninstall(id) => {
            root.plugin-uninstall(id);
        }
        close => {
            root.plugin-manager-close();
        }
    }

    // Canvas shortcuts reference (canvas-toolbar.tsx:369-380): a body-level
    // modal so it layers above the shell like the AntD original.
    if root.shortcuts-open : ShortcutsModal {
        title: I18n.dock-shortcuts;
        close => {
            root.shortcuts-close();
        }
    }

    if root.attempt-open : AttemptWorkbench {
        node-id: root.attempt-id;
        tabs: root.attempt-tabs;
        prompt: root.attempt-prompt;
        model: root.attempt-model;
        model-options: root.attempt-model-options;
        size: root.attempt-size;
        size-custom: root.attempt-size-custom;
        quality: root.attempt-quality;
        count: root.attempt-count;
        version: root.attempt-version;
        version-text: root.attempt-version-text;
        intent: root.attempt-intent;
        reason: root.attempt-reason;
        frozen: root.attempt-frozen;
        run-count: root.attempt-run-count;
        image-count: root.attempt-image-count;
        image: root.attempt-image;
        has-image: root.attempt-has-image;
        has-output: root.attempt-has-output;
        trace: root.attempt-trace;
        prompt-edited(text) => { root.attempt-prompt-edited(text); }
        version-edited(text) => { root.attempt-version-edited(text); }
        reason-edited(text) => { root.attempt-reason-edited(text); }
        config-edited(key, value) => { root.attempt-config-edited(key, value); }
        run => { root.attempt-run(); }
        duplicate => { root.attempt-duplicate(); }
        extract => { root.attempt-extract(); }
        close => { root.attempt-close(); }
        tab-picked(id) => { root.attempt-tab-picked(id); }
    }

    // Dock tooltips (`Theme.tooltip`): the button's name first, then one
    // descriptive line if the pointer stays. Body-level so it layers above the
    // canvas and the dock.
    TooltipLayer {
        z: 500;
    }

    // Keyboard focus for the canvas shortcuts (project.tsx:1192-1260).
    shortcut-focus := FocusScope {
        width: 100%;
        height: 100%;
        // The global shortcut scope spans the whole window, so click-to-focus
        // would swallow the first pointer press of every workspace (the canvas
        // area and each studio explicitly focus their own scope when clicked).
        focus-on-click: false;
        init => {
            self.focus();
        }
        key-pressed(e) => {
            root.key-down(e.text, e.modifiers.control, e.modifiers.shift);
            accept
        }
        key-released(e) => {
            root.key-up(e.text);
            accept
        }
    }
    }
}
