// Providers tab: the two preset provider cards. Name, base URL and the model
// list are read-only; the only editable value is the API key.

import { Theme } from "../../theme.slint";
import { I18n } from "../i18n.slint";
import { ConfigChannelRow } from "../overlay-types.slint";
import { FieldInput } from "settings-widgets.slint";

export component ProvidersTab inherits VerticalLayout {
    in property <[ConfigChannelRow]> channels: [];
    callback channel-field(string, string, string);

    spacing: 14px;
    Text {
        text: I18n.config-providers-title;
        font-size: 14px;
        font-weight: 600;
        color: Theme.node-text;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    for channel in root.channels : Rectangle {
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.node-stroke;
        background: Theme.card;
        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text {
                        vertical-alignment: center;
                        text: I18n.config-providers-name;
                        font-size: 11px;
                        color: Theme.muted-foreground;
                    }
                    Text {
                        text: channel.name;
                        font-size: 12px;
                        color: Theme.node-text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text {
                        vertical-alignment: center;
                        text: I18n.config-providers-base-url;
                        font-size: 11px;
                        color: Theme.muted-foreground;
                    }
                    Text {
                        text: channel.base-url;
                        font-size: 12px;
                        color: Theme.node-text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    vertical-alignment: center;
                    text: I18n.config-providers-api-key;
                    font-size: 11px;
                    color: Theme.muted-foreground;
                }
                FieldInput {
                    initial: channel.api-key;
                    placeholder: "sk-...";
                    edited(value) => {
                        root.channel-field(channel.id, "api-key", value);
                    }
                }
            }
            Text {
                text: channel.model-count-label;
                font-size: 11px;
                color: Theme.muted-foreground;
            }
            if channel.models.length == 0 : Text {
                text: I18n.config-providers-no-models;
                font-size: 12px;
                color: Theme.muted-foreground;
            }
            for model in channel.models : HorizontalLayout {
                height: 28px;
                spacing: 8px;
                Text {
                    text: model.name;
                    horizontal-stretch: 1;
                    font-size: 12px;
                    color: Theme.node-text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: model.capability-label;
                    font-size: 11px;
                    color: Theme.muted-foreground;
                    vertical-alignment: center;
                }
            }
        }
    }
}
