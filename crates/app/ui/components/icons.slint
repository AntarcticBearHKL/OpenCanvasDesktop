    // Image Studio rail glyph (`TOOLS`, image-studio.tsx:99).
    public pure function image-tool-icon(tool: string) -> string {
        return tool == "move" ? move
            : tool == "hand" ? hand
            : tool == "pen" ? pen
            : tool == "direct-select" ? pointer
            : tool == "marquee" ? select
            : tool == "ellipse-marquee" ? ellipse-select
            : tool == "lasso" ? lasso
            : tool == "polygon-lasso" ? polygon-lasso
            : tool == "wand" ? wand
            : tool == "quick-select" ? quick-select
            : tool == "brush" ? brush
            : tool == "eraser" ? eraser
            : tool == "bucket" ? bucket
            : tool == "gradient" ? gradient-square
            : tool == "shape" ? shape-tools
            : pipette;
    }}
