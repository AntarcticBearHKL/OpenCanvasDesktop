    // Missing-plugin / unknown-type glyph (crates/plugins `MISSING_PLUGIN_ICON`).
    out property <string> puzzle: "M 4 4 L 9 4 A 3 3 0 0 1 15 4 L 20 4 L 20 9 A 3 3 0 0 1 20 15 L 20 20 L 4 20 Z";
    // Plugin-contributed node types: a small gallery of node shapes.
    out property <string> plugin-types: "M 3 4 L 10 4 L 10 11 L 3 11 Z M 17.5 4 A 3.5 3.5 0 1 1 17.49 4 Z M 6.5 17.5 A 3.5 3.5 0 1 1 6.49 17.5 Z M 14 14 L 21 14 L 21 21 L 14 21 Z";

    // Node-type icon used by the node-list rows (builtin-nodes.tsx:21-29) and
    // the dock create menu (plugin types use their native equivalents).
    public pure function kind-icon(kind: string) -> string {
        return kind == "text" ? file-text
            : kind == "prompt" ? message-square-text
            : kind == "video-prompt" ? clapperboard
            : kind == "image" ? image
            : kind == "image-stack" ? images
            : kind == "image-generation" || kind == "image-attempt" ? sparkles
            : kind == "video" || kind == "video-generation" ? video
            : kind == "assets" ? folder-input
            : kind == "smart-canvas" ? smart-canvas
            : kind == "html:render" || kind == "markdown:doc" ? file-text
            : kind == "svg:vector" ? image
            : kind == "sticky-note:note" ? layers
            : kind == "panorama:viewer" ? compass
            : folder;
    }

    // Lucide key -> path for the plugin-types menu rows (keys come from the
    // registry definitions through `plugin_views::type_icon`).
    public pure function menu-icon(icon: string) -> string {
        return icon == "file-text" ? file-text
            : icon == "message-square-text" ? message-square-text
            : icon == "clapperboard" ? clapperboard
            : icon == "image" ? image
            : icon == "images" ? images
            : icon == "video" ? video
            : icon == "sparkles" ? sparkles
            : icon == "folder-input" ? folder-input
            : icon == "smart-canvas" ? smart-canvas
            : icon == "layers" ? layers
            : icon == "compass" ? compass
            : icon == "puzzle" ? puzzle
            : folder;
    }

    /// Name of a creatable built-in node type (dock tooltip + aria-ish label).
    public pure function type-name(type-id: string) -> string {
        return type-id == "text" ? "Text"
            : type-id == "prompt" ? "Image Prompt"
            : type-id == "video-prompt" ? "Video prompt"
            : type-id == "image-generation" || type-id == "image-attempt" ? "Image attempt"
            : type-id == "video-generation" ? "Video generation"
            : type-id == "image" ? "Image"
            : type-id == "image-stack" ? "Image stack"
            : type-id == "assets" ? "Assets"
            : type-id == "smart-canvas" ? "Smart Canvas"
            : "Node";
    }

    /// One-line description of a creatable built-in node type.
    public pure function type-description(type-id: string) -> string {
        return type-id == "text" ? "Add a note of plain text to the canvas"
            : type-id == "prompt" ? "Collect references and write an image prompt"
            : type-id == "video-prompt" ? "Write a prompt with keyframes for a video"
            : type-id == "image-generation" || type-id == "image-attempt" ? "One prompt/config version with its generated images"
            : type-id == "video-generation" ? "Generate a video from a connected prompt"
            : type-id == "image" ? "Display and manage a single image"
            : type-id == "image-stack" ? "Group several images; drop images onto it"
            : type-id == "assets" ? "Collect image assets for downstream nodes"
            : type-id == "smart-canvas" ? "Create a card backed by an Image Studio project"
            : "Add a node to the canvas";
    }

    /// Glyph for a floating-bar action id.
    public pure function hover-icon(id: string) -> string {
        return id == "info" ? info
            : id == "duplicate" ? copy
            : id == "font-down" ? minus
            : id == "font-up" ? plus
            : id == "layers" ? layers
            : id == "plugin-interact" ? pointer
            : id == "plugin-palette" ? gradient-square
            : id == "plugin-generate" ? sparkles
            : id == "plugin-reset" ? image
            : trash;
    }

    // Studio tool glyph (`TOOLS`, the web's tool rail).
    public pure function tool-icon(tool: string) -> string {
        return tool == "pencil" ? pencil
            : tool == "eraser" ? eraser
            : tool == "bucket" ? bucket
            : tool == "line" ? minus
            : tool == "rect" ? square
            : tool == "ellipse" ? circle
            : tool == "eyedropper" ? pipette
            : tool == "select" ? select
            : tool == "move" ? move
            : hand;
    }
