import { Theme } from "../theme.slint";
import { AttemptTabRow } from "overlay-types.slint";
import { Icons } from "icons.slint";
import { ModalShell } from "modals.slint";

// A flat select. The field itself is a soft surface with no outline; the
// options open as a small floating list so the config rows keep their rhythm.
component FlatSelect inherits Rectangle {
    in property <string> value: "";
    in property <[string]> options: [];
    in property <bool> read-only: false;
    in-out property <bool> open: false;
    callback picked(string);

    height: 32px;
    border-radius: 6px;
    background: Theme.muted;
    clip: false;

    head := Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        Text {
            x: 10px;
            width: parent.width - 34px;
            height: 100%;
            text: root.value != "" ? root.value : "Select";
            font-size: 12px;
            color: root.read-only ? Theme.node-muted : Theme.node-text;
            vertical-alignment: center;
            overflow: elide;
        }
        Path {
            x: parent.width - 20px;
            y: 11px;
            width: 10px;
            height: 10px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M 5 9 L 12 16 L 19 9";
            fill: transparent;
            stroke-width: 1.8px;
            stroke-line-cap: round;
            stroke-line-join: round;
            stroke: root.read-only ? Theme.node-muted : Theme.node-placeholder;
        }
        head-ta := TouchArea {
            width: 100%;
            height: 100%;
            enabled: !root.read-only;
            mouse-cursor: root.read-only ? default : pointer;
            clicked => {
                root.open = !root.open;
            }
        }
    }

    if root.open : Rectangle {
        y: 36px;
        width: 100%;
        height: root.options.length * 26px + 8px;
        z: 100;
        border-radius: 6px;
        background: Theme.card;
        clip: true;

        VerticalLayout {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: self.preferred-height;
            spacing: 0px;

            for option in root.options : Rectangle {
                height: 26px;
                border-radius: 4px;
                background: option-ta.has-hover ? Theme.hover : transparent;
                animate background {
                    duration: Theme.motion-hover;
                    easing: ease-out;
                }
                option-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => {
                        root.picked(option);
                        root.open = false;
                    }
                }
                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 100%;
                    text: option;
                    font-size: 12px;
                    color: Theme.node-text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

// A compact, flat number stepper. The three zones share one soft surface.
component CountStepper inherits Rectangle {
    in property <int> value: 1;
    in property <bool> read-only: false;
    callback changed(int);

    height: 32px;
    border-radius: 6px;
    background: Theme.muted;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        Rectangle {
            width: 30px;
            height: 100%;
            border-radius: 6px;
            background: minus-ta.has-hover && !root.read-only ? Theme.hover : transparent;
            minus-ta := TouchArea {
                width: 100%;
                height: 100%;
                enabled: !root.read-only;
                mouse-cursor: root.read-only ? default : pointer;
                clicked => {
                    root.changed((root.value - 1).max(1));
                }
            }
            Text {
                width: 100%;
                height: 100%;
                text: "−";
                font-size: 16px;
                color: root.read-only ? Theme.node-muted : Theme.node-text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            horizontal-stretch: 1;
            height: 100%;
            text: "" + root.value;
            font-size: 12px;
            font-weight: 600;
            color: root.read-only ? Theme.node-muted : Theme.node-text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle {
            width: 30px;
            height: 100%;
            border-radius: 6px;
            background: plus-ta.has-hover && !root.read-only ? Theme.hover : transparent;
            plus-ta := TouchArea {
                width: 100%;
                height: 100%;
                enabled: !root.read-only;
                mouse-cursor: root.read-only ? default : pointer;
                clicked => {
                    root.changed((root.value + 1).min(4));
                }
            }
            Text {
                width: 100%;
                height: 100%;
                text: "+";
                font-size: 15px;
                color: root.read-only ? Theme.node-muted : Theme.node-text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// Centered workbench for one Image Attempt. The card outside is read-only;
// this is the only place prompt/config are edited. A generated attempt is
// immutable: every editable field greys out, while duplicate/extract remain.
export component AttemptWorkbench inherits ModalShell {
    in property <string> node-id: "";
    in property <[AttemptTabRow]> tabs: [];
    in-out property <string> prompt: "";
    in property <string> model: "";
    in property <[string]> model-options: [];
    in property <string> size: "";
    in property <string> quality: "";
    in property <int> count: 1;
    in property <int> version: 1;
    in-out property <string> version-text: "1";
    in property <string> intent: "";
    in-out property <string> reason: "";
    in property <bool> frozen: false;
    in property <int> run-count: 0;
    in property <int> image-count: 0;
    in property <image> image;
    in property <bool> has-image: false;
    in property <bool> has-output: false;
    in property <string> trace: "";
    in-out property <bool> size-custom: false;

    callback prompt-edited(string);
    callback version-edited(string);
    callback reason-edited(string);
    callback config-edited(string, string);
    callback run();
    callback duplicate();
    callback extract();
    callback tab-picked(string);

    // A generated output makes the version immutable. Frozen legacy attempts
    // are read-only for the same reason.
    property <bool> read-only: root.frozen || root.has-output || root.has-image || root.image-count > 0;

    title: "Image Attempt · v" + root.version-text + (root.intent != "" ? " · " + root.intent : "");
    tier: "wide";
    panel-width: Math.min(1000px, root.width - 24px);
    body-height: Math.min(560px, root.height - 110px);
    panel-background: Theme.background;
    reveal: 1;

    VerticalLayout {
        spacing: 10px;

        // Bookmark-style version tabs. The strip is horizontal and scrolls when
        // a project has many attempts; the active version uses the brand fill.
        if root.tabs.length > 0 : Flickable {
            width: 100%;
            height: 32px;
            content-width: tabs-row.preferred-width;
            content-height: self.height;
            interactive: true;

            tabs-row := HorizontalLayout {
                spacing: 4px;

                for tab in root.tabs : Rectangle {
                    width: min(190px, max(58px, tab-text.preferred-width + 24px));
                    height: 30px;
                    border-radius: 6px;
                    background: tab.current ? Theme.brand : Theme.muted;
                    animate background {
                        duration: Theme.motion-hover;
                        easing: ease-out;
                    }

                    tab-ta := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            root.tab-picked(tab.id);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;

                        tab-text := Text {
                            text: tab.label;
                            font-size: 11px;
                            font-weight: tab.current ? 700 : 500;
                            color: tab.current ? Theme.brand-foreground : Theme.node-text;
                            vertical-alignment: center;
                            max-lines: 1;
                            overflow: elide;
                        }
                    }
                }
            }
        }
        if root.tabs.length > 0 : Rectangle {
            width: 100%;
            height: 1px;
            background: Theme.node-stroke;
            opacity: 0.45;
        }

        HorizontalLayout {
            spacing: 24px;

            // ---- compose ----------------------------------------------------
        Rectangle {
            width: 460px;
            background: transparent;

            VerticalLayout {
                spacing: 4px;

                // Prompt header: the version field is flush right and its text
                // is right-aligned, not a centred badge.
                HorizontalLayout {
                    height: 20px;
                    spacing: 8px;
                    Text {
                        text: "Prompt";
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.node-text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        visible: root.read-only;
                        text: "read-only";
                        font-size: 10px;
                        color: Theme.node-muted;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 58px;
                        height: 20px;
                        border-radius: 5px;
                        background: Theme.muted;

                        TextInput {
                            x: 6px;
                            width: parent.width - 12px;
                            height: 100%;
                            text: "v" + root.version-text;
                            read-only: root.read-only;
                            single-line: true;
                            font-size: 11px;
                            font-weight: 700;
                            color: root.read-only ? Theme.node-muted : Theme.node-text;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            edited => {
                                root.version-edited(self.text);
                            }
                        }
                    }
                }

                // Prompt is the one long field. A flat soft surface keeps it
                // legible without another outline; the gap above is deliberately
                // tight.
                Rectangle {
                    height: 160px;
                    border-radius: 8px;
                    background: Theme.muted;
                    clip: true;

                    Flickable {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        height: parent.height - 16px;
                        content-width: self.width;
                        content-height: 340px;
                        interactive: true;

                        TextInput {
                            width: parent.width;
                            height: 320px;
                            text: root.prompt;
                            read-only: root.read-only;
                            wrap: word-wrap;
                            font-size: 13px;
                            color: root.read-only ? Theme.node-muted : Theme.node-text;
                            vertical-alignment: top;
                            edited => {
                                root.prompt-edited(self.text);
                            }
                        }
                    }
                }

                Text {
                    height: 20px;
                    text: "Config";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.node-text;
                    vertical-alignment: center;
                }

                // Flat config rows: label on the left, control on the right.
                // No outer card and no per-field outline.
                VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        height: 32px;
                        spacing: 10px;
                        Text {
                            width: 72px;
                            height: 100%;
                            text: "Model";
                            font-size: 11px;
                            color: Theme.node-muted;
                            vertical-alignment: center;
                        }
                        FlatSelect {
                            horizontal-stretch: 1;
                            value: root.model;
                            options: root.model-options;
                            read-only: root.read-only;
                            picked(option) => {
                                root.config-edited("model", option);
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 32px;
                        spacing: 10px;
                        Text {
                            width: 72px;
                            height: 100%;
                            text: "Size";
                            font-size: 11px;
                            color: Theme.node-muted;
                            vertical-alignment: center;
                        }
                        FlatSelect {
                            horizontal-stretch: 1;
                            value: root.size-custom ? "Custom…" : root.size;
                            options: ["auto", "1:1", "4:3", "16:9", "9:16", "1024x1024", "1536x1024", "1024x1536", "2048x2048", "Custom…"];
                            read-only: root.read-only;
                            picked(option) => {
                                if option == "Custom…" {
                                    root.size-custom = true;
                                } else {
                                    root.size-custom = false;
                                    root.config-edited("size", option);
                                }
                            }
                        }
                    }
                    if root.size-custom : HorizontalLayout {
                        height: 32px;
                        padding-left: 82px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 32px;
                            border-radius: 6px;
                            background: Theme.muted;

                            TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: 100%;
                                text: root.size;
                                read-only: root.read-only;
                                single-line: true;
                                font-size: 12px;
                                color: root.read-only ? Theme.node-muted : Theme.node-text;
                                vertical-alignment: center;
                                edited => {
                                    root.config-edited("size", self.text);
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 32px;
                        spacing: 10px;
                        Text {
                            width: 72px;
                            height: 100%;
                            text: "Quality";
                            font-size: 11px;
                            color: Theme.node-muted;
                            vertical-alignment: center;
                        }
                        FlatSelect {
                            horizontal-stretch: 1;
                            value: root.quality;
                            options: ["auto", "low", "medium", "high"];
                            read-only: root.read-only;
                            picked(option) => {
                                root.config-edited("quality", option);
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 32px;
                        spacing: 10px;
                        Text {
                            width: 72px;
                            height: 100%;
                            text: "Count";
                            font-size: 11px;
                            color: Theme.node-muted;
                            vertical-alignment: center;
                        }
                        CountStepper {
                            horizontal-stretch: 1;
                            value: root.count;
                            read-only: root.read-only;
                            changed(value) => {
                                root.config-edited("count", "" + value);
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                // 7 : 1.5 : 1.5 action row. The last two are icon-only.
                HorizontalLayout {
                    width: 100%;
                    height: 38px;
                    spacing: 8px;

                    action := Rectangle {
                        width: (parent.width - 16px) * 0.7;
                        height: 38px;
                        border-radius: 7px;
                        background: root.read-only ? Theme.muted : (action-ta.has-hover ? Theme.node-accent : Theme.brand);
                        animate background {
                            duration: Theme.motion-hover;
                            easing: ease-out;
                        }

                        action-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            enabled: !root.read-only;
                            mouse-cursor: root.read-only ? default : pointer;
                            clicked => {
                                root.run();
                            }
                        }
                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            alignment: center;
                            spacing: 7px;
                            Rectangle {
                                width: 14px;
                                height: 100%;
                                Path {
                                    x: 0px;
                                    y: (parent.height - self.height) / 2;
                                    width: 14px;
                                    height: 14px;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    commands: Icons.play;
                                    fill: transparent;
                                    stroke-width: 2px;
                                    stroke-line-cap: round;
                                    stroke: root.read-only ? Theme.node-muted : Theme.brand-foreground;
                                }
                            }
                            Text {
                                text: "Run";
                                font-size: 12px;
                                font-weight: 600;
                                color: root.read-only ? Theme.node-muted : Theme.brand-foreground;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        width: (parent.width - 16px) * 0.15;
                        height: 38px;
                        border-radius: 7px;
                        background: duplicate-ta.has-hover ? Theme.hover : Theme.muted;
                        animate background {
                            duration: Theme.motion-hover;
                            easing: ease-out;
                        }
                        duplicate-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.duplicate();
                            }
                        }
                        Path {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: Icons.copy;
                            fill: transparent;
                            stroke-width: 1.8px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                            stroke: Theme.node-text;
                        }
                    }

                    Rectangle {
                        width: (parent.width - 16px) * 0.15;
                        height: 38px;
                        border-radius: 7px;
                        background: extract-ta.has-hover ? Theme.hover : Theme.muted;
                        animate background {
                            duration: Theme.motion-hover;
                            easing: ease-out;
                        }
                        extract-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.extract();
                            }
                        }
                        Path {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: Icons.image;
                            fill: transparent;
                            stroke-width: 1.8px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                            stroke: Theme.node-text;
                        }
                    }
                }
            }
        }

        // ---- output + merged why/trace ----------------------------------
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            VerticalLayout {
                spacing: 8px;

                Text {
                    height: 22px;
                    text: "Output";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.node-text;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 300px;
                    border-radius: 8px;
                    background: Theme.muted;
                    clip: true;

                    if root.has-image : Image {
                        width: 100%;
                        height: 100%;
                        source: root.image;
                        image-fit: contain;
                    }
                    if !root.has-image : Text {
                        width: 100%;
                        height: 100%;
                        text: "No output yet";
                        font-size: 13px;
                        color: Theme.node-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    height: 20px;
                    text: "Agent trace";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.node-text;
                    vertical-alignment: center;
                }

                // Why and the agent trace are one surface: the version note is
                // the first editable line, followed by the recorded timeline.
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    background: Theme.muted;
                    clip: true;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;

                        TextInput {
                            width: 100%;
                            height: 24px;
                            text: root.reason;
                            read-only: root.read-only;
                            single-line: true;
                            font-size: 11px;
                            color: root.read-only ? Theme.node-muted : Theme.node-text;
                            vertical-alignment: center;
                            edited => {
                                root.reason-edited(self.text);
                            }
                        }

                        Rectangle {
                            width: 100%;
                            height: 1px;
                            background: Theme.node-stroke;
                            opacity: 0.55;
                        }

                        Flickable {
                            width: 100%;
                            vertical-stretch: 1;
                            content-width: self.width;
                            content-height: Math.max(self.height, trace-text.preferred-height + 12px);
                            interactive: true;

                            trace-text := Text {
                                width: parent.width;
                                text: root.trace != "" ? root.trace : "No trace recorded for this attempt yet.";
                                font-size: 11px;
                                color: Theme.node-muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
    }
}
